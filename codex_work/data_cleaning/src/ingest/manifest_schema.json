{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StepManifest",
  "type": "object",
  "required": [
    "step_name",
    "run_id",
    "input_files",
    "output_files",
    "rows_in",
    "rows_out",
    "rows_rejected",
    "rejection_reasons",
    "created_at",
    "agent_metadata"
  ],
  "properties": {
    "step_name": { "type": "string" },
    "run_id": { "type": "string" },
    "input_files": {
      "type": "array",
      "items": { "$ref": "#/definitions/fileHash" }
    },
    "output_files": {
      "type": "array",
      "items": { "$ref": "#/definitions/fileHash" }
    },
    "rows_in": { "type": "integer" },
    "rows_out": { "type": "integer" },
    "rows_rejected": { "type": "integer" },
    "rejection_reasons": { "type": "object", "additionalProperties": { "type": "integer" } },
    "created_at": { "type": "string" },
    "agent_metadata": {
      "type": "object",
      "properties": {
        "model": { "type": "string" },
        "prompt_hash": { "type": "string" },
        "input_hash": { "type": "string" },
        "output_hash": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "fileHash": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
