{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrandRelevanceAgentIO",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "required": [
        "input_id",
        "text_normalized",
        "brand_normalized",
        "brand_original",
        "prompt_version",
        "model",
        "router_model_params"
      ],
      "properties": {
        "input_id": { "type": "string" },
        "text_normalized": { "type": "string" },
        "brand_normalized": { "type": "string" },
        "brand_original": { "type": "string" },
        "prompt_version": { "type": "string" },
        "model": { "type": "string" },
        "router_model_params": { "type": "object" },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": [
        "input_id",
        "brand_relevant",
        "router_model_used",
        "prompt_version",
        "output_hash",
        "abstain"
      ],
      "properties": {
        "input_id": { "type": "string" },
        "brand_relevant": { "type": "boolean" },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "explanation": { "type": "string" },
        "router_model_used": { "type": "string" },
        "prompt_version": { "type": "string" },
        "output_hash": { "type": "string" },
        "abstain": { "type": "boolean" },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "required": ["input", "output"],
  "additionalProperties": false
}
